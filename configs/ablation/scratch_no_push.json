{
  "notes": "First-batch ablation: keep curriculum and multi-expert AMP unchanged but zero randomized push velocity to isolate whether domain-randomized impulses cause late instability.",
  "env": {
    "domain_rand": {
      "max_push_vel_xy": 0.0,
      "max_push_ang_vel_xy": 0.0
    },
    "amp": {
      "motion_experts": {
        "walk": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/walk",
        "run": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/run",
        "jump": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/jump"
      },
      "default_motion_expert": "walk",
      "expert_style_enabled": {
        "walk": true,
        "run": true,
        "jump": true
      }
    }
  },
  "train": {
    "runner": {
      "run_name": "scratch_no_push",
      "save_top_task_checkpoints": 3,
      "max_iterations": 8000
    },
    "amp": {
      "expert_style_enabled": {
        "walk": true,
        "run": true,
        "jump": true
      }
    }
  }
}
