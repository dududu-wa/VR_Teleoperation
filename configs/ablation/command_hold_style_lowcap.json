{
  "notes": "Next-batch ablation: keep command curriculum held fixed and reduce AMP style pressure with a longer warmup plus lower task-ratio cap. This checks whether command_hold late stability improves when style remains a weaker auxiliary prior.",
  "env": {
    "commands": {
      "curriculum": false,
      "ranges": {
        "lin_vel_x": [-0.6, 0.6],
        "lin_vel_y": [-0.6, 0.6],
        "ang_vel_yaw": [-0.6, 0.6]
      }
    },
    "amp": {
      "motion_experts": {
        "walk": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/walk",
        "run": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/run",
        "jump": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/jump"
      },
      "default_motion_expert": "walk",
      "expert_style_enabled": {
        "walk": true,
        "run": true,
        "jump": true
      }
    }
  },
  "train": {
    "runner": {
      "run_name": "command_hold_style_lowcap",
      "save_top_task_checkpoints": 3,
      "max_iterations": 8000
    },
    "amp": {
      "expert_style_enabled": {
        "walk": true,
        "run": true,
        "jump": true
      },
      "style_reward_start_after": 1000,
      "style_reward_warmup_iterations": 4000,
      "style_reward_max_task_ratio": 0.15
    }
  }
}
