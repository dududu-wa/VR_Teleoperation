{
  "notes": "Staged-release follow-up after July21: keep the scratch_command_hold command range and multi-expert AMP prior, but decouple disturb release from terrain-command curriculum and cap disturb_rad_curriculum through staged levels. Stage advancement monitors run-routed noise-disturb episodes so aggregate walk/stand success cannot hide the known run failure.",
  "env": {
    "commands": {
      "curriculum": false,
      "ranges": {
        "lin_vel_x": [-0.6, 0.6],
        "lin_vel_y": [-0.6, 0.6],
        "ang_vel_yaw": [-0.6, 0.6]
      }
    },
    "disturb": {
      "start_by_curriculum": false,
      "staged_release": true,
      "stage_levels": [0.0, 0.25, 0.5, 0.75, 1.0],
      "stage_min_episodes": 512,
      "stage_min_task_return": 20.0,
      "stage_max_fall_rate": 0.10,
      "stage_monitor_noise_only": true,
      "stage_monitor_expert": "run"
    },
    "amp": {
      "motion_experts": {
        "walk": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/walk",
        "run": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/run",
        "jump": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/jump"
      },
      "default_motion_expert": "walk",
      "expert_style_enabled": {
        "walk": true,
        "run": true,
        "jump": true
      }
    }
  },
  "train": {
    "runner": {
      "run_name": "command_hold_staged_disturb_release",
      "save_top_task_checkpoints": 3,
      "max_iterations": 8000
    },
    "amp": {
      "expert_style_enabled": {
        "walk": true,
        "run": true,
        "jump": true
      }
    }
  }
}
