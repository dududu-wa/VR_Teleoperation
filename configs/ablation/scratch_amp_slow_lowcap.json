{
  "notes": "First-batch ablation: keep multi-expert routing unchanged but make AMP a weaker auxiliary prior with a longer warmup and lower task-ratio cap.",
  "env": {
    "amp": {
      "motion_experts": {
        "walk": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/walk",
        "run": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/run",
        "jump": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/jump"
      },
      "default_motion_expert": "walk",
      "expert_style_enabled": {
        "walk": true,
        "run": true,
        "jump": true
      }
    }
  },
  "train": {
    "runner": {
      "run_name": "scratch_amp_slow_lowcap",
      "save_top_task_checkpoints": 3,
      "max_iterations": 8000
    },
    "amp": {
      "expert_style_enabled": {
        "walk": true,
        "run": true,
        "jump": true
      },
      "style_reward_start_after": 1000,
      "style_reward_warmup_iterations": 4000,
      "style_reward_max_task_ratio": 0.15
    }
  }
}
