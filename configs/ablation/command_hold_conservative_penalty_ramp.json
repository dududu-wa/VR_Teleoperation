{
  "notes": "Next-batch ablation: keep command curriculum held fixed and use a middle penalty/push curriculum ramp, raising penalize_curriculum_sigma from the default 0.8 to 0.9. This tests whether a less abrupt penalty-scale release helps without the run-preset collapse seen at 0.95.",
  "env": {
    "commands": {
      "curriculum": false,
      "ranges": {
        "lin_vel_x": [-0.6, 0.6],
        "lin_vel_y": [-0.6, 0.6],
        "ang_vel_yaw": [-0.6, 0.6]
      }
    },
    "rewards": {
      "penalize_curriculum_sigma": 0.9
    },
    "amp": {
      "motion_experts": {
        "walk": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/walk",
        "run": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/run",
        "jump": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/jump"
      },
      "default_motion_expert": "walk",
      "expert_style_enabled": {
        "walk": true,
        "run": true,
        "jump": true
      }
    }
  },
  "train": {
    "runner": {
      "run_name": "command_hold_conservative_penalty_ramp",
      "save_top_task_checkpoints": 3,
      "max_iterations": 8000
    },
    "amp": {
      "expert_style_enabled": {
        "walk": true,
        "run": true,
        "jump": true
      }
    }
  }
}
