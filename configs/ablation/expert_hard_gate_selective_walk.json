{
  "env": {
    "amp": {
      "motion_experts": {
        "walk": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/walk",
        "run": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/run",
        "jump": "{LEGGED_GYM_ROOT_DIR}/legged_gym/motions/jump"
      },
      "default_motion_expert": "walk",
      "expert_style_enabled": {
        "walk": true,
        "run": false,
        "jump": false
      }
    }
  },
  "train": {
    "amp": {
      "expert_style_enabled": {
        "walk": true,
        "run": false,
        "jump": false
      }
    }
  },
  "notes": "Selective AMP ablation: keep walk style reward active while routing run/jump samples without style contribution."
}
